# Copiar a .env y ajustar según el entorno local.
# Conexión a MySQL usada por backend/src/db.ts (pool mysql2/promise).

NOTES_DB_HOST=127.0.0.1
NOTES_DB_PORT=3306
NOTES_DB_USER=root
NOTES_DB_PASSWORD=change_me
NOTES_DB_NAME=notes_web

# Puerto HTTP del servidor Express (backend/src/server.ts).
PORT=3000

# Orígenes autorizados a hacer peticiones cross-origin (CORS) al backend,
# usado por backend/src/app.ts. Uno o varios, separados por coma — por
# ejemplo, durante el deploy (feature 10) conviene tener development y
# producción habilitados a la vez:
# FRONTEND_ORIGIN=http://localhost:5173,https://notes-web.vercel.app
# Si no se define, el default es http://localhost:5173 (Vite dev).
FRONTEND_ORIGIN=http://localhost:5173

# Para correr los tests (backend/tests/notes.test.ts) contra una base de
# datos de test real y separada de la de desarrollo:
# NOTES_DB_NAME=notes_test
