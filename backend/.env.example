# Copiar a .env y ajustar según el entorno local.
# Conexión a MySQL usada por backend/src/db.ts (pool mysql2/promise).

NOTES_DB_HOST=127.0.0.1
NOTES_DB_PORT=3306
NOTES_DB_USER=root
NOTES_DB_PASSWORD=change_me
NOTES_DB_NAME=notes_web

# Activa TLS en la conexión a MySQL usando el perfil `Amazon RDS` de mysql2
# (bundle de CAs de Amazon resuelto vía `aws-ssl-profiles`, dependencia
# transitiva ya presente, sin certificados que descargar a mano). Necesario
# para conectar a una instancia RDS real (feature `aws_deploy`); en MySQL
# local (Docker o instalado directo) se deja en false.
# NOTES_DB_SSL=true
NOTES_DB_SSL=false

# Puerto HTTP del servidor Express (backend/src/server.ts).
PORT=3000

# Orígenes autorizados a hacer peticiones cross-origin (CORS) al backend,
# usado por backend/src/app.ts. Uno o varios, separados por coma — por
# ejemplo, durante el deploy (feature 10) conviene tener development y
# producción habilitados a la vez:
# FRONTEND_ORIGIN=http://localhost:5173,https://notes-web.vercel.app
# Si no se define, el default es http://localhost:5173 (Vite dev).
FRONTEND_ORIGIN=http://localhost:5173

# Para correr los tests (backend/tests/notes.test.ts) contra una base de
# datos de test real y separada de la de desarrollo:
# NOTES_DB_NAME=notes_test

# Secreto usado para firmar/verificar el JWT de sesión (backend/src/auth.ts).
# El valor de abajo es SOLO un ejemplo para desarrollo local — la app falla
# al arrancar si no está definido (a propósito, ver backend/src/auth.ts), y
# NUNCA hay que usar este valor de ejemplo en producción: ahí tiene que ser
# un secreto real, largo y aleatorio (por ejemplo, generado con
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# y guardado como variable de entorno del hosting, nunca commiteado).
# Cualquiera que conozca este valor puede fabricar una sesión válida para
# cualquier usuario, así que también hay que rotarlo (invalidando todas las
# sesiones activas) si alguna vez se filtra.
JWT_SECRET=dev-only-secret-do-not-use-in-production-2f8a1c9e7b3d4f60
